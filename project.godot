; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Occultra"
run/main_scene="res://Game/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

SettingsManager="*res://Game/settings_manager.gd"
GoldSystem="*uid://bjrv5d7sp3rmd"
RunState="*uid://cijodei4dg718"
CutsceneManager="*uid://bglfdl4ykevqf"
SaveManager="*res://Game/save_manager.gd"
PauseMenu="*res://Game/pause_menu.gd"
MusicManager="*res://Game/music_manager.gd"
SkillTreeMenu="*res://Game/skill_tree_menu.gd"
EnemySoundManager="*res://Game/enemy_sound_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[global_group]

player=""
player_attack=""
enemy=""
shop_overlay=""
enemy_hurtbox=""
boss_bar=""
hud=""
projectile_ignore=""
player_summon=""
main_menu=""

